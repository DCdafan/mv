{
  "name": "shiguang-mv",
  "productName": "拾光MV",
  "version": "1.2.0",
  "description": "影楼 MV 电子相册自动生成软件",
  "main": "./out/main/index.js",
  "author": "shiguang",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist:mac": "electron-vite build && electron-builder --mac --arm64"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "playwright-core": "^1.49.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.18",
    "exifr": "^7.1.3",
    "ffmpeg-static": "^5.2.0",
    "lucide-react": "^0.460.0",
    "mp4-muxer": "^5.1.5",
    "nanoid": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "build": {
    "appId": "com.shiguang.mv",
    "productName": "拾光MV",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      {
        "from": "resources/music",
        "to": "music"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "dmg": {
      "title": "拾光MV"
    }
  },
  "license": "MIT"
}
